# Template des variables d'environnement de Carneo.
# Copie ce fichier vers .env (gitignored, jamais committé) et remplis les valeurs.
#   cp .env.example .env
#
# Les variables sont regroupées par phase : ne remplis que celles dont tu as besoin
# maintenant, les autres attendent la phase qui les utilise.

# === Phase 1 — Supabase (auth, PostgreSQL, Storage) ===
# supabase.com/dashboard → ton projet → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (nommée « Secret key » ou « service_role » selon ton dashboard).
# Contourne la RLS, usage serveur uniquement.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais importer dans un composant client.
# Nécessaire au cron de la Phase 7 et au seed du compte de démo (Phase 6).
SUPABASE_SECRET_KEY=

# === Phase 5 — Extraction des factures par photo ===
# console.anthropic.com → API Keys. Serveur uniquement.
ANTHROPIC_API_KEY=

# === Phase 7 — Rappels par email ===
# resend.com → API Keys
RESEND_API_KEY=

# Secret partagé protégeant la route de cron contre un déclenchement externe.
# Génère-le toi-même (ex : openssl rand -hex 32) et reporte la même valeur
# dans les variables d'environnement Vercel.
CRON_SECRET=
